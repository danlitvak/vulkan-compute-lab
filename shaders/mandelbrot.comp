#version 450

// One invocation per pixel. 16x16 = 256 threads per workgroup, which maps
// cleanly onto both AMD wave64 and NVIDIA warp32 scheduling.
layout(local_size_x = 16, local_size_y = 16) in;

// `rgba8` must match the VK_FORMAT_R8G8B8A8_UNORM target created on the host.
layout(binding = 0, rgba8) uniform writeonly image2D target;

// Offsets must match the PushConstants struct in src/app.hpp.
layout(push_constant) uniform Push {
    vec2  resolution;
    vec2  mouse;
    float time;
    float deltaTime;
    uint  frame;
} pc;

const int   MAX_ITER = 480;
const float BAILOUT2 = 256.0; // squared escape radius

// Iñigo Quílez cosine palette.
vec3 palette(float t) {
    const vec3 a = vec3(0.50, 0.50, 0.50);
    const vec3 b = vec3(0.50, 0.45, 0.40);
    const vec3 c = vec3(1.00, 1.00, 1.00);
    const vec3 d = vec3(0.00, 0.12, 0.24);
    return a + b * cos(6.28318530718 * (c * t + d));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = ivec2(pc.resolution);

    // The dispatch is rounded up to whole workgroups, so the last row and
    // column of invocations can fall outside the image.
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2 uv = (vec2(pixel) - 0.5 * pc.resolution) / pc.resolution.y;

    // Breathe between a wide view and a deep zoom.
    float phase = 0.5 - 0.5 * cos(pc.time * 0.18);
    float scale = 2.4 * exp(-6.0 * phase);

    // The mouse nudges the target point, so live uniforms are visible.
    vec2 pan = (pc.mouse / pc.resolution - 0.5) * 0.35 * scale;
    vec2 c   = vec2(-0.743643887037151, 0.131825904205330) + pan + uv * scale;

    vec2 z = vec2(0.0);
    int  i = 0;
    for (; i < MAX_ITER; ++i) {
        z = vec2(z.x * z.x - z.y * z.y, 2.0 * z.x * z.y) + c;
        if (dot(z, z) > BAILOUT2) break;
    }

    vec3 colour = vec3(0.02, 0.02, 0.03); // inside the set
    if (i < MAX_ITER) {
        // Fractional iteration count — without this the bands are hard edges.
        float smoothIter = float(i) + 1.0 - log2(log2(length(z)));
        colour = palette(0.030 * smoothIter + 0.05 * pc.time);
        colour *= smoothstep(0.0, 5.0, smoothIter); // darken the outermost band
    }

    imageStore(target, pixel, vec4(colour, 1.0));
}
