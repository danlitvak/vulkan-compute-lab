#version 450

//!alias noise fbm clouds

// A second shader, mostly to prove the swap path works:
//   lab.exe shaders/warp.comp
// Domain-warped value noise — cheap per pixel, so it also serves as a rough
// "is the compute dispatch the bottleneck?" comparison against mandelbrot.

layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) uniform writeonly image2D target;

layout(push_constant) uniform Push {
    vec2  resolution;
    vec2  mouse;      // normalised 0..1, y down
    vec2  center;     // view centre, in screen-height units at zoom 1
    float zoom;       // 1.0 at rest
    float time;
    float deltaTime;
    uint  frame;
} pc;

// Integer bit-mixing hash. The usual fract(sin(dot(p, k)) * large) trick breaks
// down in fp32 once the coordinates grow past a few dozen units: neighbouring
// lattice points start correlating and the noise field shows hard axis-aligned
// blocks. Integer mixing is exact, so it has no such falloff.
uint hashUint(uvec2 v) {
    uint x = v.x * 0x9E3779B9u ^ v.y * 0x85EBCA6Bu;
    x ^= x >> 16; x *= 0x7FEB352Du;
    x ^= x >> 15; x *= 0x846CA68Bu;
    x ^= x >> 16;
    return x;
}

float hash(vec2 p) {
    // The +4096 bias keeps the common near-origin coordinates away from the
    // wrap point of the signed-to-unsigned conversion.
    return float(hashUint(uvec2(ivec2(floor(p)) + 4096))) / 4294967295.0;
}

float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f); // smoothstep interpolation
    return mix(mix(hash(i + vec2(0, 0)), hash(i + vec2(1, 0)), u.x),
               mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), u.x), u.y);
}

float fbm(vec2 p) {
    float sum = 0.0;
    float amplitude = 0.5;
    for (int octave = 0; octave < 5; ++octave) {
        sum += amplitude * noise(p);
        p *= 2.02;
        amplitude *= 0.5;
    }
    return sum;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = ivec2(pc.resolution);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    // Drag to pan, scroll to zoom. The centre comes from accumulated cursor
    // deltas, so the field slides with the cursor instead of snapping.
    vec2 uv = (vec2(pixel) - 0.5 * pc.resolution) / pc.resolution.y;
    vec2 p  = (pc.center + uv / pc.zoom) * 3.0;

    // Two rounds of domain warping: feed noise back into its own coordinates.
    vec2 q = vec2(fbm(p + 0.10 * pc.time),
                  fbm(p + vec2(5.2, 1.3) - 0.10 * pc.time));
    vec2 r = vec2(fbm(p + 4.0 * q + vec2(1.7, 9.2) + 0.15 * pc.time),
                  fbm(p + 4.0 * q + vec2(8.3, 2.8) - 0.12 * pc.time));
    float f = fbm(p + 4.0 * r);

    vec3 colour = mix(vec3(0.05, 0.06, 0.09), vec3(0.85, 0.87, 0.92), f * f);
    colour = mix(colour, vec3(0.30, 0.45, 0.65), clamp(length(q), 0.0, 1.0) * 0.5);

    imageStore(target, pixel, vec4(colour, 1.0));
}
